# RSSB Health Insurance — Claims & Fraud Detection Portal
# Copy this file to ".env" and fill in your own Supabase project values.

# --- Supabase (server-side, used by api/ routes) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase (client-side, used by the Vite frontend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: Google sign-in ---
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_AUTH_PROXY=https://your-oauth-proxy/callback
